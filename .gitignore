# Virtual environment
Scratch.venv/
*.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build/Distribution
dist/
build/
*.egg-info/
node_modules/

# Application specific
*.log
preferences.config
preferences.json
# imgui rewrites this every session, so a tracked copy is pure churn. Kept
# consistent with preferences.json above: both are per-user session state, not
# project source. A canonical default layout, if ever wanted, ships as
# default_imgui.ini the way Reference/ does.
imgui.ini

# Search output: a run writes a config and a 512px capture per candidate, so a
# few generations is hundreds of files and tens of megabytes. Results are
# working data -- promote a config worth keeping into configs/custom/ by hand.
documents/
# tex_sim.py's embedding cache, keyed by backend signature.
.texsim_cache/
